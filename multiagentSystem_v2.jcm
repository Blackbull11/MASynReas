mas multiagentSystem {

    agent coordinator: coordinator_agent.asl

    agent critical_alarm_agent: worker_agent.asl {
        beliefs: worker_id("critical_alarm_agent"), python_script("detection_major.py"), result_file("result_major.json")
    }
    agent propagation_agent: worker_agent.asl {
        beliefs: worker_id("propagation_agent"), python_script("detection_propagation.py"), result_file("result_propagation.json")
    }
    agent unhandled_agent: worker_agent.asl {
        beliefs: worker_id("unhandled_agent"), python_script("detection_unhandled.py"), result_file("result_unhandled.json")
    }

    workspace sparql_workspace {
        artifact sparql_manager: org.kg.SparqlArtifact()
    }
}