    workspace w {
        artifact pyexec: env.PythonExecArtifact()
    }

    asl-path: ., src/agt, src/agt/structural/apriori, src/agt/structural/aposteriori, src/agt/dynamic/apriori, src/agt/dynamic/aposteriori
    java-path: ., src/env, src/agt
