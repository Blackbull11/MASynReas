mas multiagentSystem {

    agent apriori_test_controller {
        focus: w.pyexec
    }

    agent orphan_resource_detector {
        focus: w.pyexec
    }

    agent missing_interface_detector {
        focus: w.pyexec
    }

    agent orphan_interface_detector {
        focus: w.pyexec
    }

    agent unconnected_interface_detector {
        focus: w.pyexec
    }

    agent incomplete_network_link_detector {
        focus: w.pyexec
    }

    agent missing_parent_resource_detector {
        focus: w.pyexec
    }

    agent application_without_support_detector {
        focus: w.pyexec
    }

    agent unmanaged_resource_detector {
        focus: w.pyexec
    }

    agent missing_redundancy_detector {
        focus: w.pyexec
    }

    agent criticality_structural_weakness_detector {
        focus: w.pyexec
    }

    agent isolated_incident_resource_detector {
        focus: w.pyexec
    }

    agent incident_on_incomplete_link_detector {
        focus: w.pyexec
    }

    agent high_impact_resource_detector {
        focus: w.pyexec
    }

    agent no_redundancy_incident_detector {
        focus: w.pyexec
    }

    agent application_mapping_inconsistency_detector {
        focus: w.pyexec
    }

    agent spatial_incident_cluster_detector {
        focus: w.pyexec
    }

    agent child_component_incident_escalation_detector {
        focus: w.pyexec
    }

    workspace w {
        artifact pyexec: env.PythonExecArtifact()
    }

    asl-path: ., src/agt, src/agt/structural/apriori, src/agt/structural/aposteriori
    java-path: ., src/env, src/agt
}
