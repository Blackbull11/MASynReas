mas multiagentSystem {

    agent apriori_test_controller {
        focus: w.pyexec
    }

    agent orphan_resource_detector {
        focus: w.pyexec
    }

    agent missing_interface_detector {
        focus: w.pyexec
    }

    agent orphan_interface_detector {
        focus: w.pyexec
    }

