    }

    agent application_without_support_detector {
        focus: w.pyexec
    }

    agent unmanaged_resource_detector {
        focus: w.pyexec
    }

    agent missing_redundancy_detector {
        focus: w.pyexec
    }

    agent criticality_structural_weakness_detector {
        focus: w.pyexec
    }

    agent change_without_effective_time_detector {
        focus: w.pyexec
    }

    agent event_without_related_element_detector {
        focus: w.pyexec
    }

    agent event_without_timestamp_detector {
        focus: w.pyexec
    }

