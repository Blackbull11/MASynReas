        focus: w.pyexec
    }

    agent high_impact_resource_detector {
        focus: w.pyexec
    }

    agent no_redundancy_incident_detector {
        focus: w.pyexec
    }

    agent application_mapping_inconsistency_detector {
        focus: w.pyexec
    }

