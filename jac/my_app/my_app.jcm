mas my_app {

    agent bob: sample_agent.asl {
      focus: w.c1 
    }

    workspace w {
      artifact c1: example.Counter(3) 
      artifact kg: kg.KGSparqlArtifact("http://localhost:8890/sparql")
    }

    organisation o: org.xml {
      group g1 : group1 {
        players: bob role1
      }
    }

    

}
