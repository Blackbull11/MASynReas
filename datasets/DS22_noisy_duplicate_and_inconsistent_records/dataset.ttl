baseB:procedure_restart_customer_portal
    a pep:Procedure ;
    rdfs:label "Restart customer portal node"@en .

baseB:procedure_clear_billing_queue
    a pep:Procedure ;
    rdfs:label "Clear billing queue"@en .

baseB:procedure_restart_monitoring_agent
    a pep:Procedure ;
    rdfs:label "Restart monitoring agent"@en .

baseB:procedure_restart_workforce_api
    a pep:Procedure ;
    rdfs:label "Restart workforce API"@en .

baseB:change_switch_maintenance
    a noria:ChangeRequest ;
    rdfs:label "Access switch maintenance"@en ;
    noria:eventRelatedElement baseB:res_access_switch_01 ;
    noria:plannedStartDate "2026-02-01T07:00:00Z"^^xsd:dateTime ;
    noria:plannedEndDate "2026-02-01T07:45:00Z"^^xsd:dateTime ;
    noria:changeRequestActualStartTime "2026-02-01T07:05:00Z"^^xsd:dateTime ;
    noria:changeRequestActualEndTime "2026-02-01T07:30:00Z"^^xsd:dateTime .

baseB:change_firewall_policy_review
    a noria:ChangeRequest ;
    rdfs:label "Firewall policy review"@en ;
    noria:eventRelatedElement baseB:res_firewall_02 ;
    noria:plannedStartDate "2026-02-03T08:00:00Z"^^xsd:dateTime ;
    noria:plannedEndDate "2026-02-03T08:30:00Z"^^xsd:dateTime ;
    noria:changeRequestActualStartTime "2026-02-03T08:05:00Z"^^xsd:dateTime ;
    noria:changeRequestActualEndTime "2026-02-03T08:20:00Z"^^xsd:dateTime .

baseB:change_customer_release
    a noria:ChangeRequest ;
    rdfs:label "Customer portal release deployment"@en ;
    noria:eventRelatedElement baseB:app_customer_portal ;
    noria:plannedStartDate "2026-02-06T09:00:00Z"^^xsd:dateTime ;
    noria:plannedEndDate "2026-02-06T09:45:00Z"^^xsd:dateTime ;
    noria:changeRequestActualStartTime "2026-02-06T09:10:00Z"^^xsd:dateTime ;
    noria:changeRequestActualEndTime "2026-02-06T09:35:00Z"^^xsd:dateTime .

baseB:service_shadow_ops
    a noria:Service ;
    rdfs:label "Shadow Ops Service"@en .

baseB:app_shadow_ops
    a noria:Application ;
    rdfs:label "Shadow Ops Application"@en ;
    noria:businessCriticality baseB:criticality_medium .

baseB:module_shadow_ops
    a noria:ApplicationModule ;
    rdfs:label "Shadow Ops Module"@en ;
    seas:subSystemOf baseB:service_shadow_ops ;
    seas:subSystemOf baseB:service_network_monitoring ;
    noria:applicationModuleOf baseB:app_shadow_ops .

baseB:res_shadow_probe
    a noria:Resource ;
    rdfs:label "Shadow Probe Resource"@en ;
    noria:resourceType baseB:type_virtual_machine ;
    noria:resourceManagedBy baseB:team_platform ;
    noria:resourceForApplication baseB:app_shadow_ops ;
    noria:resourceForApplication baseB:app_monitoring_dashboard ;
    noria:locatedIn baseB:room_dc2 ;
    seas:subSystemOf baseB:zone_monitoring .

