    a noria:NetworkInterface ;
    noria:networkInterfaceOf baseB:res_monitor_vm_02 ;
    noria:networkInterfaceConnects baseB:link_monitor_vm_02_to_firewall_02 .

baseB:if_workforce_vm_01
    a noria:NetworkInterface ;
