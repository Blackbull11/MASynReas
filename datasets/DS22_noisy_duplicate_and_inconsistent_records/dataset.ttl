baseB:link_customer_vm_01_to_switch_01
    a noria:NetworkLink ;
    noria:networkLinkTerminationResource baseB:res_customer_vm_01, baseB:res_access_switch_01 .

baseB:link_customer_vm_02_to_switch_02
    a noria:NetworkLink ;
    noria:networkLinkTerminationResource baseB:res_customer_vm_02, baseB:res_access_switch_02 .

baseB:link_billing_api_01_to_switch_01
    a noria:NetworkLink ;
    noria:networkLinkTerminationResource baseB:res_billing_api_01, baseB:res_access_switch_01 .

baseB:link_billing_api_02_to_switch_02
    a noria:NetworkLink ;
    noria:networkLinkTerminationResource baseB:res_billing_api_02, baseB:res_access_switch_02 .

baseB:link_monitor_vm_01_to_firewall_01
    a noria:NetworkLink ;
    noria:networkLinkTerminationResource baseB:res_monitor_vm_01, baseB:res_firewall_01 .

baseB:link_monitor_vm_02_to_firewall_02
    a noria:NetworkLink ;
    noria:networkLinkTerminationResource baseB:res_monitor_vm_02, baseB:res_firewall_02 .

baseB:link_workforce_vm_01_to_firewall_01
