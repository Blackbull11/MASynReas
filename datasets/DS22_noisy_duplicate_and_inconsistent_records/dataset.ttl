@prefix baseB: <https://example.org/masynreas/datasets/baseB/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix noria: <https://w3id.org/noria/ontology/> .
@prefix pep: <https://w3id.org/pep/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix seas: <https://w3id.org/seas/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

baseB:dataset
    a noria:Dataset ;
    rdfs:label "MASynReas Base B"@en ;
    dcterms:description "Richer healthy NORIA-O reference graph for MASynReas."@en .

baseB:team_platform
    a foaf:Agent ;
    rdfs:label "Platform Operations Team"@en .

baseB:team_network
    a foaf:Agent ;
    rdfs:label "Network Operations Team"@en .

baseB:team_business_apps
    a foaf:Agent ;
    rdfs:label "Business Applications Team"@en .

baseB:type_virtual_machine
    a skos:Concept ;
    rdfs:label "Virtual machine"@en .

baseB:type_api_node
    a skos:Concept ;
    rdfs:label "API node"@en .

baseB:type_switch
    a skos:Concept ;
    rdfs:label "Network switch"@en .

baseB:type_firewall
    a skos:Concept ;
    rdfs:label "Firewall"@en .

baseB:criticality_medium
    a skos:Concept ;
    rdfs:label "Medium"@en .

baseB:severity_minor
    a skos:Concept ;
    rdfs:label "Minor"@en .

baseB:priority_normal
    a skos:Concept ;
    rdfs:label "Normal"@en .

baseB:urgency_normal
    a skos:Concept ;
    rdfs:label "Normal"@en .

baseB:status_closed
    a skos:Concept ;
    rdfs:label "Closed"@en .

baseB:event_type_warning
    a skos:Concept ;
    rdfs:label "Warning event"@en .

baseB:site_paris_dc
    rdfs:label "Paris DC"@en .

baseB:room_dc1
    rdfs:label "Paris DC room 1"@en .

baseB:room_dc2
    rdfs:label "Paris DC room 2"@en .

baseB:zone_customer
    rdfs:label "Customer application zone"@en .

baseB:zone_billing
    rdfs:label "Billing application zone"@en .

baseB:zone_monitoring
    rdfs:label "Monitoring application zone"@en .

baseB:zone_workforce
    rdfs:label "Workforce application zone"@en .

baseB:zone_network
    rdfs:label "Shared network zone"@en .

baseB:service_customer_access
    a noria:Service ;
    rdfs:label "Customer Access Service"@en ;
    prov:wasDerivedFrom "MASynReas-baseB" .

baseB:service_billing_api
    a noria:Service ;
    rdfs:label "Billing API Service"@en ;
    prov:wasDerivedFrom "MASynReas-baseB" .

baseB:service_network_monitoring
    a noria:Service ;
    rdfs:label "Network Monitoring Service"@en ;
    prov:wasDerivedFrom "MASynReas-baseB" .

baseB:service_workforce_portal
    a noria:Service ;
    rdfs:label "Workforce Portal Service"@en ;
    prov:wasDerivedFrom "MASynReas-baseB" .

baseB:module_customer_portal
    a noria:ApplicationModule ;
    rdfs:label "Customer Portal Module"@en ;
    seas:subSystemOf baseB:service_customer_access ;
    noria:applicationModuleOf baseB:app_customer_portal .

baseB:module_billing_gateway
    a noria:ApplicationModule ;
    rdfs:label "Billing Gateway Module"@en ;
    seas:subSystemOf baseB:service_billing_api ;
    noria:applicationModuleOf baseB:app_billing_gateway .

baseB:module_monitoring_dashboard
    a noria:ApplicationModule ;
    rdfs:label "Monitoring Dashboard Module"@en ;
    seas:subSystemOf baseB:service_network_monitoring ;
    noria:applicationModuleOf baseB:app_monitoring_dashboard .

baseB:module_workforce_console
    a noria:ApplicationModule ;
    rdfs:label "Workforce Console Module"@en ;
    seas:subSystemOf baseB:service_workforce_portal ;
    noria:applicationModuleOf baseB:app_workforce_console .

baseB:app_customer_portal
    a noria:Application ;
    rdfs:label "Customer Portal"@en ;
    noria:businessCriticality <https://w3id.org/noria/kos/application/criticality/high-critical> .

baseB:app_billing_gateway
    a noria:Application ;
    rdfs:label "Billing Gateway"@en ;
    noria:businessCriticality <https://w3id.org/noria/kos/application/criticality/critical> .

baseB:app_monitoring_dashboard
    a noria:Application ;
    rdfs:label "Monitoring Dashboard"@en ;
    noria:businessCriticality baseB:criticality_medium .

baseB:app_workforce_console
    a noria:Application ;
    rdfs:label "Workforce Console"@en ;
    noria:businessCriticality baseB:criticality_medium .

baseB:res_customer_vm_01
    a noria:Resource ;
    rdfs:label "Customer VM 01"@en ;
    noria:resourceType baseB:type_virtual_machine ;
    noria:resourceManagedBy baseB:team_platform ;
    noria:resourceForApplication baseB:app_customer_portal ;
    noria:locatedIn baseB:room_dc1 ;
    seas:subSystemOf baseB:zone_customer .

baseB:res_customer_vm_02
    a noria:Resource ;
    rdfs:label "Customer VM 02"@en ;
    noria:resourceType baseB:type_virtual_machine ;
    noria:resourceManagedBy baseB:team_platform ;
    noria:resourceForApplication baseB:app_customer_portal ;
    noria:locatedIn baseB:room_dc2 ;
    seas:subSystemOf baseB:zone_customer .

