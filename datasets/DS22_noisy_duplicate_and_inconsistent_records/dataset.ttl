    a noria:Resource ;
    rdfs:label "Access Switch 01"@en ;
    noria:resourceType baseB:type_switch ;
    noria:resourceManagedBy baseB:team_network ;
    noria:locatedIn baseB:room_dc1 ;
    seas:subSystemOf baseB:zone_network .

baseB:res_access_switch_02
    a noria:Resource ;
    rdfs:label "Access Switch 02"@en ;
    noria:resourceType baseB:type_switch ;
    noria:resourceManagedBy baseB:team_network ;
    noria:locatedIn baseB:room_dc2 ;
    seas:subSystemOf baseB:zone_network .

baseB:res_firewall_01
    a noria:Resource ;
    rdfs:label "Firewall 01"@en ;
    noria:resourceType baseB:type_firewall ;
    noria:resourceManagedBy baseB:team_network ;
    noria:locatedIn baseB:room_dc1 ;
    seas:subSystemOf baseB:zone_network .

baseB:res_firewall_02
    a noria:Resource ;
    rdfs:label "Firewall 02"@en ;
    noria:resourceType baseB:type_firewall ;
    noria:resourceManagedBy baseB:team_network ;
    noria:locatedIn baseB:room_dc2 ;
    seas:subSystemOf baseB:zone_network .

baseB:if_customer_vm_01
    a noria:NetworkInterface ;
    noria:networkInterfaceOf baseB:res_customer_vm_01 ;
    noria:networkInterfaceConnects baseB:link_customer_vm_01_to_switch_01 .

baseB:if_customer_vm_02
    a noria:NetworkInterface ;
    noria:networkInterfaceOf baseB:res_customer_vm_02 ;
    noria:networkInterfaceConnects baseB:link_customer_vm_02_to_switch_02 .

baseB:if_billing_api_01
    a noria:NetworkInterface ;
    noria:networkInterfaceOf baseB:res_billing_api_01 ;
    noria:networkInterfaceConnects baseB:link_billing_api_01_to_switch_01 .

baseB:if_billing_api_02
    a noria:NetworkInterface ;
    noria:networkInterfaceOf baseB:res_billing_api_02 ;
    noria:networkInterfaceConnects baseB:link_billing_api_02_to_switch_02 .

