    noria:resourceType baseB:type_api_node ;
    noria:resourceManagedBy baseB:team_business_apps ;
    noria:resourceForApplication baseB:app_billing_gateway ;
    noria:locatedIn baseB:room_dc1 ;
    seas:subSystemOf baseB:zone_billing .

baseB:res_billing_api_02
    a noria:Resource ;
    rdfs:label "Billing API Node 02"@en ;
    noria:resourceType baseB:type_api_node ;
    noria:resourceManagedBy baseB:team_business_apps ;
    noria:resourceForApplication baseB:app_billing_gateway ;
    noria:locatedIn baseB:room_dc2 ;
    seas:subSystemOf baseB:zone_billing .

baseB:res_monitor_vm_01
    a noria:Resource ;
    rdfs:label "Monitoring VM 01"@en ;
    noria:resourceType baseB:type_virtual_machine ;
    noria:resourceManagedBy baseB:team_platform ;
    noria:resourceForApplication baseB:app_monitoring_dashboard ;
    noria:locatedIn baseB:room_dc1 ;
    seas:subSystemOf baseB:zone_monitoring .

baseB:res_monitor_vm_02
    a noria:Resource ;
    rdfs:label "Monitoring VM 02"@en ;
    noria:resourceType baseB:type_virtual_machine ;
    noria:resourceManagedBy baseB:team_platform ;
    noria:resourceForApplication baseB:app_monitoring_dashboard ;
    noria:locatedIn baseB:room_dc2 ;
    seas:subSystemOf baseB:zone_monitoring .

baseB:res_workforce_vm_01
    a noria:Resource ;
    rdfs:label "Workforce VM 01"@en ;
    noria:resourceType baseB:type_virtual_machine ;
    noria:resourceManagedBy baseB:team_platform ;
    noria:resourceForApplication baseB:app_workforce_console ;
